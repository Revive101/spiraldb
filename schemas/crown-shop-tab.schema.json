{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crown-shop-tab.schema.json",
  "title": "CrownShopTab",
  "type": "object",
  "properties": {
    "tabId": {
      "type": "integer"
    },
    "name": {
      "type": "string"
