          "categoryId": {
            "type": "integer"
          },
          "parentTabId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          },
          "flags": {
            "type": "object",
