    "icon": {
      "type": "string"
    },
    "categoryIds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "tags": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
